# Optional controller-container overrides. Copy to .gradlemcp.env (mode 0600).
# The helper command ./gmc writes these values safely.
# GRADLEMCP_UI_ENABLED=true
# GRADLEMCP_PUBLIC_URL=https://builds.example.org
# GRADLEMCP_MCP_ALLOWED_HOSTS='["builds.example.org:*"]'
# GRADLEMCP_MCP_ALLOWED_ORIGINS='["https://builds.example.org"]'
